# ============================================================
# 海洋院团总支数字工作台 — 环境变量
# ============================================================

# ---------- PostgreSQL（仅服务端使用） ----------
# 生产环境建议 PostgreSQL 与 Next.js 同机通信，不要暴露 5432 到公网。
# 请将真实值写入 .env 或 .env.local，禁止提交到 Git。
DATABASE_URL=

# 仅用于 npm run db:seed；必须显式设置，项目不会提供默认密码。
SEED_DEFAULT_PASSWORD=

# ---------- 服务监听 ----------
NODE_ENV=development
HOSTNAME=127.0.0.1
PORT=3000

# ---------- 本地文件存储（仅服务端使用） ----------
# 当前 Rocky 用户级生产路径只能位于 /home/wyz；未来建立 /srv bind mount 后只替换根路径。
# Windows 开发环境可使用同样的五目录契约，例如 C:/Users/USER/tzz-data/blobs。
FILE_STORAGE_ROOT=/home/wyz/tzz-data/blobs
UPLOAD_TMP_ROOT=/home/wyz/tzz-data/tmp
QUARANTINE_ROOT=/home/wyz/tzz-data/quarantine
EXPORT_ROOT=/home/wyz/tzz-data/exports
THUMBNAIL_ROOT=/home/wyz/tzz-data/thumbnails
# 单文件上限；客户端只用于预校验，服务端 FILE_MAX_SIZE_BYTES 为最终裁决。
FILE_MAX_SIZE_BYTES=21474836480
NEXT_PUBLIC_FILE_MAX_SIZE_BYTES=21474836480
# 历史文件批量导入目录（不由 Web API 公开）。
IMPORT_ROOT=/home/wyz/tzz-data/import
