# ============================================================
# 海洋院团总支数字工作台 — 环境变量
# ============================================================

# ---------- PostgreSQL（仅服务端使用） ----------
# 生产环境建议 PostgreSQL 与 Next.js 同机通信，不要暴露 5432 到公网。
# 请将真实值写入 .env 或 .env.local，禁止提交到 Git。
DATABASE_URL=

# ---------- 本地文件存储（仅服务端使用） ----------
# 生产示例：/data/tzz/files
# Windows 开发示例：C:/data/ocean-youth/files
FILE_STORAGE_ROOT=

# 运行模式
# development: 使用 Mock 数据
# production: 连接真实后端
NEXT_PUBLIC_APP_MODE=development

# ---------- Supabase (未来接入) ----------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- 阿里云 OSS (未来接入) ----------
# ALIYUN_OSS_REGION=oss-cn-hangzhou
# ALIYUN_OSS_BUCKET=ocean-youth-workspace
# ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ---------- 通知服务 (未来接入) ----------
# FEISHU_WEBHOOK_URL=
# WECOM_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ---------- 应用配置 ----------
# NEXT_PUBLIC_APP_URL=http://localhost:3000
